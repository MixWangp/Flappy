rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Player profile: /players/{uid} = { name, updatedAt }
    match /players/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
        && validName(request.resource.data.name)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Personal bests: /leaderboard/{uid} = { name, score, updatedAt }
    match /leaderboard/{uid} {
      allow read: if true;                       // everyone sees the leaderboard
      allow create: if isOwner(uid) && validEntry();
      allow update: if isOwner(uid) && validEntry()
        && request.resource.data.score >= resource.data.score; // score can never go down
      allow delete: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 16;
    }

    function validEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'score', 'updatedAt'])
        && validName(d.name)
        && d.score is int && d.score >= 0 && d.score <= 9999
        && d.updatedAt == request.time;
    }

    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
